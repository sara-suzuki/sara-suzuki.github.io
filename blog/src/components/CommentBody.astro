---
// The byline and text of one comment or reply. Text is rendered as plain
// text (never HTML); a blank line starts a new paragraph.
interface Props {
  comment: { name: string; date: Date; text: string; author: boolean };
}

const { comment } = Astro.props;

function formatDate(date: Date) {
  // Frontmatter dates parse as UTC midnight; format in UTC so they don't shift a day earlier
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}

const paragraphs = comment.text.trim().split(/\n\s*\n/);
---

<p class="comment-meta">
  <span class="comment-author">{comment.name}</span>
  {comment.author && <span class="comment-badge">Author</span>}
  <span aria-hidden="true"> · </span>
  <time datetime={comment.date.toISOString().slice(0, 10)}>{formatDate(comment.date)}</time>
</p>
{paragraphs.map(p => <p>{p}</p>)}
