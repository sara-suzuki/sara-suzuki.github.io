---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentBody from '../../components/CommentBody.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { comments } = post.data;

function formatDate(date: Date) {
  // Frontmatter dates parse as UTC midnight; format in UTC so they don't shift a day earlier
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={`${post.data.title} | Sara Suzuki`} description={post.data.description}>
  <div class="container">
    <a href="/blog/" class="back-link">Blog</a>

    <article class="blog-prose">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-meta">{formatDate(post.data.date)}</p>
      </header>

      <Content />
    </article>

    <section class="comments" id="comments" aria-labelledby="comments-heading">
      <h2 id="comments-heading">Comments</h2>

      {comments.length > 0 && (
        <ol class="comment-list">
          {comments.map((comment, i) => (
            <li class="comment" id={`comment-${i + 1}`}>
              <CommentBody comment={comment} />

              {comment.replies.length > 0 && (
                <ol class="comment-replies" aria-label={`Replies to ${comment.name}`}>
                  {comment.replies.map(reply => (
                    <li class="reply"><CommentBody comment={reply} /></li>
                  ))}
                </ol>
              )}

              {/* Hidden until the script below runs: replying needs JavaScript */}
              <button
                type="button"
                class="comment-reply-button"
                data-reply-to={`#${i + 1} ${comment.name} (${formatDate(comment.date)})`}
                data-reply-name={comment.name}
                hidden
              >Reply</button>
            </li>
          ))}
        </ol>
      )}

      <!-- Netlify Forms picks this form up at deploy time; submissions land in
           the Netlify dashboard and appear here only once copied into the
           post's frontmatter. bot-field is a honeypot for spam bots. -->
      <form
        class="comment-form"
        name="blog-comments"
        method="POST"
        action="/blog/comment-received/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="blog-comments" />
        <input type="hidden" name="post" value={post.slug} />
        <!-- Filled in by the Reply buttons, e.g. "#1 Caleb Whitehouse (November 16, 2026)" -->
        <input type="hidden" name="reply_to" value="" />
        <p class="comment-honeypot">
          <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <p class="comment-replying" hidden>
          Replying to <strong class="comment-replying-name"></strong>
          <button type="button" class="comment-reply-cancel">Cancel</button>
        </p>

        <p class="comment-form-note">
          Comments are reviewed before they appear here. Your email address is optional and will not be published.
        </p>

        <div>
          <label for="comment-name">Name</label>
          <input id="comment-name" name="name" type="text" required maxlength="100" autocomplete="name" />
        </div>

        <div>
          <label for="comment-email">Email <span class="optional">(optional, not published)</span></label>
          <input id="comment-email" name="email" type="email" maxlength="200" autocomplete="email" />
        </div>

        <div>
          <label for="comment-text">Comment</label>
          <textarea id="comment-text" name="comment" required maxlength="3000" rows="6"></textarea>
        </div>

        <p class="comment-form-note">
          By submitting, you agree that your name and comment may be published on this page.
        </p>

        <button type="submit">Submit comment</button>
        <p class="comment-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  // Submit in the background so readers stay on the post. Without
  // JavaScript, the form posts normally and lands on /blog/comment-received/
  // (and the Reply buttons stay hidden, so every submission is a comment).
  const form = document.querySelector<HTMLFormElement>('.comment-form');
  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.comment-status')!;
    const replyTo = form.querySelector<HTMLInputElement>('input[name="reply_to"]')!;
    const replying = form.querySelector<HTMLElement>('.comment-replying')!;
    const replyingName = form.querySelector<HTMLElement>('.comment-replying-name')!;
    const nameField = form.querySelector<HTMLInputElement>('#comment-name')!;
    const textField = form.querySelector<HTMLTextAreaElement>('#comment-text')!;
    let activeReplyButton: HTMLButtonElement | null = null;

    // Point the form at a comment (or back at the post, with null)
    function setReply(button: HTMLButtonElement | null) {
      activeReplyButton = button;
      replyTo.value = button?.dataset.replyTo ?? '';
      replyingName.textContent = button?.dataset.replyName ?? '';
      replying.hidden = !button;
      submitButton.textContent = button ? 'Submit reply' : 'Submit comment';
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLButtonElement>('.comment-reply-button').forEach(button => {
      button.hidden = false;
      button.addEventListener('click', () => {
        setReply(button);
        status.textContent = '';
        form.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        (nameField.value ? textField : nameField).focus({ preventScroll: true });
      });
    });

    form.querySelector('.comment-reply-cancel')!.addEventListener('click', () => {
      const button = activeReplyButton;
      setReply(null);
      button?.focus();
    });

    form.addEventListener('submit', async event => {
      event.preventDefault();
      const isReply = replyTo.value !== '';
      submitButton.disabled = true;
      status.textContent = 'Sending…';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        setReply(null); // reset() leaves hidden inputs alone
        status.textContent = `Thank you! Your ${isReply ? 'reply' : 'comment'} will appear here once it has been reviewed.`;
      } catch {
        status.textContent = `Something went wrong, and your ${isReply ? 'reply' : 'comment'} was not sent. Please try again.`;
      }
      submitButton.disabled = false;
    });
  }
</script>
